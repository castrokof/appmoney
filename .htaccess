# Para cuando el repo se despliega directo en public_html (sin poder cambiar la carpeta raíz).
# Todo se sirve desde public/; lo demás (.env, vendor, app, .git...) queda inalcanzable.
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
